# Server Configuration
PORT=5000

# AI / LLM Configuration
# Supports Google Gemini API (Recommended), OpenAI API, or OpenRouter
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_API_KEY=your_llm_api_key_here

# Demo Mode (true = returns realistic dynamic mock recipes without API key, false = calls real LLM API)
DEMO_MODE=false
